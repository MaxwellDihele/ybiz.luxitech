NEXT_PUBLIC_SITE_URL=https://luxitech.ybiz.co.za
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. Used for checkout and webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Public Cloudflare R2 custom domain, e.g. https://media.luxitech.co.za
NEXT_PUBLIC_MEDIA_BASE_URL=
# Shared secret so the admin app can trigger instant store refreshes (use a long random string)
REVALIDATE_SECRET=

# Yoco (use sk_test_... while testing)
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=

# Delivery pricing in cents (placeholders: R99 flat, free over R1000). Set your real rates.
NEXT_PUBLIC_SHIPPING_FLAT_CENTS=9900
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_CENTS=100000
